{
  "name": "نَسَق | NASAQ",
  "short_name": "نَسَق",
  "description": "منصة نَسَق لإعداد وتصميم التقارير والمخرجات المؤسسية بجودة طباعية عالية.",
  "id": "/",
  "start_url": "/editor",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "dir": "rtl",
  "lang": "ar",
  "background_color": "#006c35",
  "theme_color": "#006c35",
  "categories": ["productivity", "business", "design"],
  "icons": [
    {
      "src": "/icons/nasaq-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/nasaq-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/nasaq-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/nasaq-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "محرر نَسَق | NASAQ Editor",
      "short_name": "المحرر",
      "description": "فتح محرر نَسَق لإنشاء وتصميم المستندات والتقارير",
      "url": "/editor",
      "icons": [
        {
          "src": "/icons/nasaq-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/open",
      "accept": {
        "application/vnd.nasaq.project+zip": [".nsq"]
      },
      "icons": [
        {
          "src": "/icons/nasaq-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}
