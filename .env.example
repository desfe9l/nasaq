# NASAQ server configuration (copy to .env; never commit .env)
# NASAQ uses Better Auth's direct Google provider. Keep the client secret
# server-side in the deployment environment; never commit it or expose it to Vite.
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://nasaq-sa.vercel.app
BETTER_AUTH_SECRET=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Paylink is the payment provider. Keygen is the licensing authority.
# Paylink credentials and webhook token are server-only deployment secrets.
#   Production API base: https://restapi.paylink.sa
#   Testing API base:    https://restpilot.paylink.sa
PAYLINK_API_BASE_URL=https://restapi.paylink.sa
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
# The exact Bearer value entered in My Paylink → Settings → Webhook → Headers.
# The endpoint rejects every callback until this matches, character for character.
PAYLINK_WEBHOOK_TOKEN=
# Public origin used to build callBackUrl / cancelUrl and the webhook URL.
PAYLINK_PUBLIC_URL=https://nasaq-sa.vercel.app
# Webhook endpoint to register in My Paylink → Settings (choose API version V2):
#   https://nasaq-sa.vercel.app/api/webhooks/paylink
KEYGEN_ACCOUNT_SLUG=ararcomksa-twilight-fire-2288
KEYGEN_PRODUCT_ID=c109271b-9c97-4827-bc9d-48e7982744fe
# Product token permissions: entitlement.read, license.read, license.create,
# license.update, license.suspend, license.reinstate, user.read, user.create,
# license.users.attach (needed to bind an unassigned user-locked key on activation).
# Keep this token server-only; a token with only license.create cannot claim keys.
KEYGEN_API_TOKEN=
# Ed25519 hexadecimal verify key from Keygen Developers settings.
KEYGEN_PUBLIC_KEY=
KEYGEN_POLICY_TRIAL_ID=ab6e0fdd-7e5e-4329-afe1-6c9e6b92acb7
KEYGEN_POLICY_INDIVIDUAL_MONTHLY_ID=e9bea931-5416-4a91-95f8-8a90b26a2cd6
KEYGEN_POLICY_INDIVIDUAL_QUARTERLY_ID=7b078b25-8fd0-485d-9dd6-75b92afb24c9
KEYGEN_POLICY_TEAM_MONTHLY_ID=2b6984ed-1022-4718-a0b3-cc07c4cd5dad
KEYGEN_POLICY_TEAM_QUARTERLY_ID=6a4b079a-45f8-4e94-90a6-b8864acbfd96
KEYGEN_POLICY_LIFETIME_ID=3704e4a4-5645-4be7-b6c9-2067c722341d
KEYGEN_POLICY_INDIVIDUAL_ANNUAL_ID=
KEYGEN_POLICY_TEAM_ANNUAL_ID=
NASAQ_OWNER_ID=
NASAQ_OWNER_EMAIL=
# Owner bypass for licence administration (SUPER_ADMIN). Accepts verified user
# ids and/or email addresses, comma-separated. The owner record above is always
# treated as a super administrator, with or without these.
NASAQ_SUPER_ADMIN_IDS=
NASAQ_SUPER_ADMIN_EMAILS=
# Optional explicit admin allowlist: comma-separated verified user IDs and/or emails.
# Admin identities receive full access without a paid subscription.
NASAQ_ADMIN_USER_IDS=
XAI_API_KEY=
NASAQ_AI_MODEL=grok-3-mini
