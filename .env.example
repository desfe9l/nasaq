# NASAQ server configuration (copy to .env; never commit .env)
# NASAQ uses Better Auth's direct Google provider. Keep the client secret
# server-side in the deployment environment; never commit it or expose it to Vite.
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://nasaq-sa.vercel.app
BETTER_AUTH_SECRET=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=1372880
LEMONSQUEEZY_INDIVIDUAL_MONTHLY_VARIANT_ID=2145099
LEMONSQUEEZY_INDIVIDUAL_QUARTERLY_VARIANT_ID=2145142
LEMONSQUEEZY_TEAM_MONTHLY_VARIANT_ID=2147936
LEMONSQUEEZY_TEAM_QUARTERLY_VARIANT_ID=2147937
LEMONSQUEEZY_INDIVIDUAL_MONTHLY_CHECKOUT_URL=
LEMONSQUEEZY_INDIVIDUAL_QUARTERLY_CHECKOUT_URL=
LEMONSQUEEZY_TEAM_MONTHLY_CHECKOUT_URL=
LEMONSQUEEZY_TEAM_QUARTERLY_CHECKOUT_URL=
NASAQ_OWNER_ID=
NASAQ_OWNER_EMAIL=
XAI_API_KEY=
NASAQ_AI_MODEL=grok-3-mini
